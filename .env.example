# ============================================================
# AIKYAM contact form email configuration
# Copy this file to .env and add your real credentials.
# IMPORTANT: These variables are server-only. Do NOT prefix them with VITE_.
# ============================================================

# Server
PORT=3001
NODE_ENV=development
# Set true only when your deployment is behind a trusted reverse proxy.
TRUST_PROXY=false
CONTACT_RATE_LIMIT_MAX=8

# SMTP example (Gmail / Google Workspace shown below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT_MS=15000
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password-or-app-password

# Recipient that receives website enquiries
MAIL_TO=info@aikyam.co

# Optional. If omitted, SMTP_USER is used automatically.
MAIL_FROM="AIKYAM Website <your-email@yourdomain.com>"

# Development only: Vite proxies /api requests to this server.
VITE_API_PROXY_TARGET=http://localhost:3001
